{
  "name": "cachet-tools",
  "private": true,
  "type": "module",
  "description": "Measurement and deployment scripts. Scripts that call the model need NEARAI_API_KEY in ../.env.",
  "scripts": {
    "verify-tee": "node verify-tee.mjs",
    "eval": "node --env-file=../.env eval.mjs",
    "plan": "node --env-file=../.env plan.mjs",
    "two-readers": "node --env-file=../.env two-readers.mjs",
    "explain": "node --env-file=../.env explain.mjs",
    "read-real": "node --env-file=../.env read-real.mjs",
    "via-relay": "node via-relay.mjs",
